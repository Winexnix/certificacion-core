{
    "name": "winex/certificacion",
    "description": "Integracion con el SII de Chile: firma electronica, timbre (TED/CAF) y emision de Boleta Electronica (canal SOAP DTEWS + API REST).",
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.9.1",
    "authors": [
        {
            "name": "Meniaz",
            "email": "williammenares0@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "vlucas/phpdotenv": "^5.7"
    },
    "suggest": {
        "ext-soap": "Solo lo necesita SiiSoapClient (canal SOAP DTEWS del flujo de certificacion)."
    },
    "autoload": {
        "psr-4": {
            "Winex\\Certificacion\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "Winex\\Certificacion\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
