# Copia este archivo a .env y completalo. El .env NUNCA se versiona.

# Certificado digital del SII (.pfx) y su clave
SII_CERT_PATH=data/certs/mi-certificado.pfx
SII_CERT_PASS=
# Ruta al binario de openssl ("openssl" si esta en el PATH)
SII_OPENSSL_PATH=openssl

# Datos del emisor que usan los scripts de bin/
SII_RUT_EMPRESA=76123456-0
SII_RUT_FIRMA=12345678-5
EMISOR_RAZON_SOCIAL="MI EMPRESA SPA"
EMISOR_GIRO="ACTIVIDADES DE CONSULTORIA DE INFORMATICA"
EMISOR_DIRECCION="CALLE 123"
EMISOR_COMUNA=SANTIAGO
